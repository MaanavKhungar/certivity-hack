  {
   "id": "R42-base-0011",
   "text": "The front protective device shall be subjected to a longitudinal impact test consisting of two impacts on the front surface of the vehicle: one with the vehicle at unladen weight (paragraph 3.1.3.) and one with the vehicle at laden test weight (paragraph 3.1.4.).",
   "table": null,
   "regulation": "UN R42",
