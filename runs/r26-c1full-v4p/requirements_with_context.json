{
 "regulation": "UN R26",
 "role": "base",
 "hops": 2,
 "requirements": [
  {
   "id": "R26-base-0001",
   "text": "The external projection provisions of UN R26 do not apply to those parts of the lamp's external surface (outer lens, exposed housing rim or seal) which, with the vehicle in the laden condition and all doors, windows and access lids closed, are either at a height of more than 2 m, or below the floor line, or so located that, in their static condition as well as in operation, they cannot be contacted by a sphere 100 mm in diameter.",
   "table": null,
   "regulation": "UN R26",
   "version": "4.0.0",
   "role": "base",
   "source_node_ids": [
    "R26|base|5.1.1",
