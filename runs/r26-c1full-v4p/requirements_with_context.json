  {
   "id": "R26-base-0004",
   "text": "No protruding part of the lamp's external surface (outer lens edges, exposed housing rim/bezel edges) shall have a radius of curvature less than 2.5 mm; this does not apply to parts which protrude less than 5 mm, but the outward facing angles of such parts shall be blunted, save where such parts protrude less than 1.5 mm.",
   "table": null,
   "regulation": "UN R26",
   "version": "4.0.0",
   "role": "base",
   "source_node_ids": [
    "R26|base|5.4"
   ],
