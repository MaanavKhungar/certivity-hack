  {
   "id": "R26-base-0003",
   "text": "The lamp's external surface, as installed on the M1 vehicle, shall not exhibit, directed outwards, any part likely to catch on pedestrians, cyclists or motor cyclists.",
   "table": null,
   "regulation": "UN R26",
   "version": "4.0.0",
   "role": "base",
   "source_node_ids": [
    "R26|base|5.3"
   ],
   "source": {
